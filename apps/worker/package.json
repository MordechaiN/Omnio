{
  "name": "@omnio/worker",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Omnio processing worker — the sandboxed home of all heavy file work. M1 ships the process skeleton and health endpoint; BullMQ consumers arrive in M3.",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --onSuccess \"node dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "codegen": "modgen"
  },
  "dependencies": {
    "@omnio/core": "workspace:*",
    "@omnio/db": "workspace:*",
    "@omnio/jobs": "workspace:*",
    "@omnio/module-sdk": "workspace:*",
    "@omnio/storage": "workspace:*",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.1",
    "pino": "^9.5.0",
    "zod": "^3.25.0",
    "@omnio/mod-officekit": "workspace:*"
  },
  "devDependencies": {
    "@omnio/config": "workspace:*",
    "@omnio/modgen": "workspace:*",
    "@types/node": "^22.15.0",
    "eslint": "^9.30.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
