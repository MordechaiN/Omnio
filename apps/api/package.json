{
  "name": "@omnio/api",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Omnio HTTP API — NestJS implementation of @omnio/contracts.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch & node --watch dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@omnio/contracts": "workspace:*",
    "@omnio/core": "workspace:*",
    "@omnio/db": "workspace:*",
    "@ts-rest/nest": "^3.52.0",
    "ioredis": "^5.4.1",
    "nestjs-pino": "^4.1.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@omnio/config": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "eslint": "^9.30.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
