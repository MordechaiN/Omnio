{
  "name": "@omnio/api",
  "version": "0.1.0-alpha.1",
  "private": true,
  "license": "Apache-2.0",
  "description": "Omnio HTTP API — NestJS implementation of @omnio/contracts.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch & node --watch dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "codegen": "modgen"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@omnio/contracts": "workspace:*",
    "@omnio/core": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "@omnio/db": "workspace:*",
    "@omnio/jobs": "workspace:*",
    "@omnio/storage": "workspace:*",
    "@ts-rest/nest": "^3.52.0",
    "bullmq": "^5.34.0",
    "busboy": "^1.6.0",
    "cookie": "^1.0.2",
    "file-type": "^21.3.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "nestjs-pino": "^4.1.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@omnio/config": "workspace:*",
    "@omnio/modgen": "workspace:*",
    "@testcontainers/postgresql": "^10.13.0",
    "@testcontainers/redis": "^10.13.0",
    "@types/busboy": "^1.5.4",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.30.0",
    "supertest": "^7.0.0",
    "testcontainers": "^10.13.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
