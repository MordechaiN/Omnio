{
  "name": "@omnio/scaffold",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Module and tool scaffolders. `pnpm new:module` / `new:tool` generate a manifest, a ToolShell-ready surface, i18n stubs, and a test so a contributor ships a tool in minutes.",
  "type": "module",
  "bin": {
    "omnio-scaffold": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@omnio/core": "workspace:*"
  },
  "devDependencies": {
    "@omnio/config": "workspace:*",
    "@types/node": "^22.15.0",
    "eslint": "^9.30.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
