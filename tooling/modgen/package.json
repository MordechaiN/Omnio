{
  "name": "@omnio/modgen",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Build-time module discovery and registry codegen. Globs packages/modules, validates manifests against @omnio/module-sdk, and emits the typed web/api/worker/search registries + capabilities.json.",
  "type": "module",
  "bin": {
    "modgen": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup src/cli.ts src/index.ts --format esm --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@omnio/core": "workspace:*",
    "@omnio/module-sdk": "workspace:*",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@omnio/config": "workspace:*",
    "@types/node": "^22.15.0",
    "eslint": "^9.30.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
