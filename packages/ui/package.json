{
  "name": "@omnio/ui",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "The Omnio design system: tokens, primitives, patterns. Ships as TypeScript source; apps transpile it (Next transpilePackages, Storybook via Vite).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles/*": "./src/styles/*",
    "./fonts": "./src/fonts.ts"
  },
  "scripts": {
    "build": "node scripts/generate-tokens.ts",
    "gen:tokens": "node scripts/generate-tokens.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@fontsource-variable/noto-sans-hebrew": "^5.2.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-checkbox": "^1.3.0",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-radio-group": "^1.3.0",
    "@radix-ui/react-select": "^2.2.0",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@radix-ui/react-visually-hidden": "^1.2.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cmdk": "^1.1.0",
    "lucide-react": "^0.525.0",
    "next-themes": "^0.4.0",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.3.0",
    "tw-animate-css": "^1.3.0"
  },
  "devDependencies": {
    "@omnio/config": "workspace:*",
    "@storybook/addon-a11y": "^10.5.0",
    "@storybook/react-vite": "^10.5.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/culori": "^2.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "culori": "^4.0.0",
    "eslint": "^9.30.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "storybook": "^10.5.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.8.0",
    "vite": "^8.1.4",
    "vitest": "^3.2.0"
  }
}
