{
  "name": "@omnio/workspace",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "The file workspace: content-addressed local storage (OPFS + IndexedDB), metadata, tags, collections, relationships and history.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/react.ts --format esm,cjs --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@omnio/config": "workspace:*",
    "eslint": "^9.30.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0",
    "react": "^19.0.0",
    "@types/react": "^19.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
