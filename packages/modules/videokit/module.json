{
  "$schema": "https://omnio.dev/schemas/module.v1.json",
  "id": "videokit",
  "version": "1.0.0",
  "category": "video",
  "icon": "film",
  "i18nNamespace": "mod-videokit",
  "tools": [
    {
      "id": "frame-extract",
      "tier": "browser",
      "surface": "frontend/tools/frame-extract",
      "keywords": [
        "video",
        "frame",
        "extract",
        "screenshot",
        "still",
        "thumbnail"
      ],
      "accepts": [
        {
          "mime": [
            "video/*"
          ],
          "priority": 90
        }
      ]
    },
    {
      "id": "thumbnail-sheet",
      "tier": "browser",
      "surface": "frontend/tools/thumbnail-sheet",
      "keywords": [
        "thumbnail",
        "preview",
        "sheet",
        "storyboard",
        "video",
        "grid"
      ],
      "accepts": [
        {
          "mime": [
            "video/*"
          ],
          "priority": 80
        }
      ]
    }
  ],
  "capabilities": {
    "fileActions": []
  },
  "permissions": []
}
