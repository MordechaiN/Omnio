{
  "$schema": "https://omnio.dev/schemas/module.v1.json",
  "id": "audiokit",
  "version": "1.0.0",
  "category": "audio",
  "icon": "audio-waveform",
  "i18nNamespace": "mod-audiokit",
  "tools": [
    {
      "id": "audio-inspect",
      "tier": "browser",
      "surface": "frontend/tools/audio-inspect",
      "icon": "audio-lines",
      "keywords": [
        "audio",
        "inspect",
        "duration",
        "length",
        "bitrate",
        "quality",
        "how long",
        "size",
        "mp3",
        "details"
      ],
      "accepts": [
        {
          "mime": [
            "audio/*"
          ],
          "priority": 88
        }
      ]
    },
    {
      "id": "audio-trim",
      "tier": "browser",
      "surface": "frontend/tools/audio-trim",
      "keywords": [
        "audio",
        "trim",
        "cut",
        "clip",
        "wav",
        "mp3",
        "sound",
        "ringtone"
      ],
      "accepts": [
        {
          "mime": [
            "audio/*"
          ],
          "priority": 90
        }
      ]
    },
    {
      "id": "waveform-view",
      "tier": "browser",
      "surface": "frontend/tools/waveform-view",
      "keywords": [
        "waveform",
        "audio",
        "visualize",
        "amplitude",
        "preview"
      ],
      "accepts": [
        {
          "mime": [
            "audio/*"
          ],
          "priority": 55
        }
      ]
    },
    {
      "id": "audio-fade",
      "tier": "browser",
      "surface": "frontend/tools/audio-fade",
      "keywords": [
        "fade",
        "fade in",
        "fade out",
        "audio",
        "smooth",
        "envelope"
      ],
      "accepts": [
        {
          "mime": [
            "audio/*"
          ],
          "priority": 60
        }
      ]
    }
  ],
  "capabilities": {
    "fileActions": []
  },
  "permissions": []
}
