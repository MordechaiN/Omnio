{
  "$schema": "https://omnio.dev/schemas/module.v1.json",
  "id": "officekit",
  "version": "1.0.0",
  "category": "office",
  "icon": "table",
  "i18nNamespace": "mod-officekit",
  "tools": [
    {
      "id": "csv-table",
      "tier": "browser",
      "surface": "frontend/tools/csv-table",
      "keywords": [
        "csv",
        "table",
        "preview",
        "spreadsheet",
        "viewer",
        "columns"
      ],
      "accepts": [
        {
          "mime": [
            "text/csv",
            "application/csv"
          ],
          "priority": 85
        }
      ]
    },
    {
      "id": "tsv-table",
      "tier": "browser",
      "surface": "frontend/tools/tsv-table",
      "keywords": [
        "tsv",
        "tab separated",
        "table",
        "preview"
      ],
      "accepts": [
        {
          "mime": [
            "text/tab-separated-values"
          ],
          "priority": 82
        }
      ]
    },
    {
      "id": "html-preview",
      "tier": "browser",
      "surface": "frontend/tools/html-preview",
      "keywords": [
        "html",
        "preview",
        "render",
        "sandbox"
      ],
      "accepts": [
        {
          "mime": [
            "text/html"
          ],
          "priority": 80
        }
      ]
    }
  ],
  "capabilities": {
    "fileActions": []
  },
  "permissions": []
}
