{
  "$schema": "https://omnio.dev/schemas/module.v1.json",
  "id": "slugify",
  "version": "1.0.0",
  "category": "text",
  "icon": "link-2",
  "i18nNamespace": "mod-slugify",
  "tools": [
    {
      "id": "slugify",
      "tier": "browser",
      "surface": "frontend/tools/slugify",
      "keywords": [
        "slug",
        "url",
        "permalink",
        "seo"
      ]
    },
    {
      "id": "filename-clean",
      "tier": "browser",
      "surface": "frontend/tools/filename-clean",
      "keywords": [
        "filename",
        "sanitize",
        "clean",
        "rename",
        "safe",
        "invalid characters"
      ]
    },
    {
      "id": "bulk-rename",
      "tier": "browser",
      "surface": "frontend/tools/bulk-rename",
      "keywords": [
        "bulk rename",
        "rename",
        "rules",
        "batch",
        "filenames",
        "sequence"
      ],
      "accepts": [
        {
          "mime": [
            "*/*"
          ],
          "multiple": true,
          "priority": 5
        }
      ]
    }
  ],
  "capabilities": {
    "fileActions": []
  },
  "permissions": []
}
