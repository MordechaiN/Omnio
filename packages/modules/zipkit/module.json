{
  "$schema": "https://omnio.dev/schemas/module.v1.json",
  "id": "zipkit",
  "version": "1.0.0",
  "category": "archives",
  "icon": "folder-archive",
  "i18nNamespace": "mod-zipkit",
  "tools": [
    {
      "id": "zip-inspect",
      "tier": "browser",
      "surface": "frontend/tools/zip-inspect",
      "icon": "search",
      "keywords": [
        "zip",
        "archive",
        "inspect",
        "contents",
        "what is inside",
        "list",
        "peek",
        "preview"
      ],
      "accepts": [
        {
          "mime": [
            "application/zip",
            "application/x-zip-compressed"
          ],
          "priority": 94
        }
      ]
    },
    {
      "id": "zip-create",
      "tier": "browser",
      "surface": "frontend/tools/zip-create",
      "keywords": [
        "zip",
        "archive",
        "compress",
        "bundle",
        "pack"
      ],
      "accepts": [
        {
          "mime": [
            "*/*"
          ],
          "multiple": true,
          "priority": 25
        }
      ]
    },
    {
      "id": "zip-extract",
      "tier": "browser",
      "surface": "frontend/tools/zip-extract",
      "keywords": [
        "zip",
        "unzip",
        "extract",
        "archive",
        "open",
        "unpack"
      ],
      "accepts": [
        {
          "mime": [
            "application/zip",
            "application/x-zip-compressed"
          ],
          "priority": 92
        }
      ]
    }
  ],
  "capabilities": {
    "fileActions": []
  },
  "permissions": []
}
