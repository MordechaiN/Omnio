{
  "$schema": "https://omnio.dev/schemas/module.v1.json",
  "id": "pdfkit",
  "version": "1.0.0",
  "category": "pdf",
  "icon": "file-text",
  "i18nNamespace": "mod-pdfkit",
  "tools": [
    {
      "id": "pdf-merge",
      "tier": "browser",
      "surface": "frontend/tools/pdf-merge",
      "keywords": [
        "pdf",
        "merge",
        "combine",
        "join",
        "concatenate"
      ],
      "accepts": [
        {
          "mime": [
            "application/pdf"
          ],
          "multiple": true,
          "priority": 90
        }
      ]
    },
    {
      "id": "pdf-split",
      "tier": "browser",
      "surface": "frontend/tools/pdf-split",
      "keywords": [
        "pdf",
        "split",
        "extract",
        "pages",
        "range"
      ],
      "accepts": [
        {
          "mime": [
            "application/pdf"
          ],
          "priority": 86
        }
      ]
    },
    {
      "id": "pdf-rotate",
      "tier": "browser",
      "surface": "frontend/tools/pdf-rotate",
      "keywords": [
        "pdf",
        "rotate",
        "turn",
        "orientation",
        "pages"
      ],
      "accepts": [
        {
          "mime": [
            "application/pdf"
          ],
          "priority": 80
        }
      ]
    },
    {
      "id": "pdf-delete",
      "tier": "browser",
      "surface": "frontend/tools/pdf-delete",
      "keywords": [
        "pdf",
        "delete",
        "remove",
        "pages",
        "clean"
      ],
      "accepts": [
        {
          "mime": [
            "application/pdf"
          ],
          "priority": 78
        }
      ]
    },
    {
      "id": "pdf-reorder",
      "tier": "browser",
      "surface": "frontend/tools/pdf-reorder",
      "keywords": [
        "pdf",
        "reorder",
        "rearrange",
        "sort",
        "move",
        "pages"
      ],
      "accepts": [
        {
          "mime": [
            "application/pdf"
          ],
          "priority": 76
        }
      ]
    }
  ],
  "capabilities": {
    "fileActions": []
  },
  "permissions": []
}
