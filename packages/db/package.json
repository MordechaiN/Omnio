{
  "name": "@omnio/db",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Prisma schema, client factory, and migrate-on-boot runner for the Omnio core data model. Server-only (CommonJS); consumed by api and worker.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./prisma/schema.prisma": "./prisma/schema.prisma"
  },
  "files": [
    "dist",
    "prisma",
    "generated"
  ],
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "prisma": "^6.3.0"
  },
  "devDependencies": {
    "@omnio/config": "workspace:*",
    "@types/node": "^22.15.0",
    "eslint": "^9.30.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
