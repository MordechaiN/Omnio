# Omnio environment configuration
# Copy to .env and adjust. Every variable is validated at boot — the process
# refuses to start with an invalid configuration and tells you exactly why.

# Ports: Omnio uses 7400-7449 and nothing else, so it never competes with
# another project for 3000, 4000, 5432 or 6379 (docs/ports.md).

# --- data stores (match docker/compose.dev.yaml) ---
OMNIO_DATABASE_URL=postgresql://omnio:omnio@localhost:7432/omnio
OMNIO_REDIS_URL=redis://localhost:7479

# --- api ---
OMNIO_API_PORT=7410
# Loopback by default. Only bind every interface when something outside this
# machine must reach the api directly — in personal mode there is no login.
OMNIO_API_HOST=127.0.0.1
# Extra browser origins for CORS + the CSRF origin check (comma-separated).
# Same-origin is always allowed; leave empty when the SPA and api share an origin.
OMNIO_ALLOWED_ORIGINS=http://localhost:7400
# Set true only behind a trusted reverse proxy (so req.ip reflects the client).
OMNIO_TRUST_PROXY=false

# --- auth (decision D2, reversed 2026-07-18) ---
# "personal" (default): no login, no accounts — everything is immediately usable
# by whoever can reach the instance. "multi-user": single-admin account with a
# password, set during a first-run setup screen.
OMNIO_MODE=personal
# Required in production; both the dev default and this placeholder are refused
# there, so leave it commented out and generate a real one:
#   echo "OMNIO_SESSION_SECRET=$(openssl rand -hex 32)" >> .env
# Left unset, the stack refuses to start and tells you this — which is better
# than starting with a secret everyone who has read the repo already knows.
# OMNIO_SESSION_SECRET=
OMNIO_SESSION_TTL_HOURS=168
# Permit OMNIO_MODE=personal on a non-local bind — true by default since personal
# mode (above) has no login anyway; this is what lets it boot without extra config.
# Set to false if you switch OMNIO_MODE to multi-user and want the stricter posture.
OMNIO_AUTH_ALLOW_INSECURE=true

# --- storage & retention (decision D3) ---
OMNIO_STORAGE_ROOT=./.omnio-data
OMNIO_MAX_UPLOAD_MB=512
OMNIO_SCRATCH_TTL_HOURS=24
OMNIO_SWEEP_INTERVAL_MINUTES=60

# --- worker ---
OMNIO_WORKER_HEALTH_PORT=7420
OMNIO_WORKER_CONCURRENCY=4

# --- observability ---
OMNIO_LOG_LEVEL=info

# --- web ---
# Base URL the browser uses to reach the API (through your reverse proxy in prod)
NEXT_PUBLIC_API_URL=http://localhost:7410
